{% import "macros/entry.tex.j2" as entry %}

{% macro render(section, minimal) %}
\hrulefill
\section*{ {{- section.title | tex -}} }
{% if not minimal %}
{{ section.description }}
{% endif %}
\hrulefill
\subsection*{Contents:}
\begin{enumerate}
{% for e in section.entries %}
    \item {{ e.title | tex }}
{% endfor %}
\end{enumerate}
{% for e in section.entries %}
{{ entry.render(e, minimal) }}
{% endfor %}
{% endmacro %}