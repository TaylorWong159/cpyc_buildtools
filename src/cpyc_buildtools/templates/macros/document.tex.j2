{% import "macros/section.tex.j2" as section %}

{% macro render(document, minimal) %}
\title{ {{- document.title | tex -}} }
\author{ {{- document.authors | tex -}} }
\date{}
\maketitle
{% if not minimal %}
{{ document.description }}
{% endif %}
\hrulefill
\subsection*{Contents:}
\begin{enumerate}
{% for s in document.sections %}
\item {{ s.title | tex }}
{% endfor %}
\end{enumerate}

{% for s in document.sections %}
{{ section.render(s, minimal) }}
{% endfor %}
{% endmacro %}